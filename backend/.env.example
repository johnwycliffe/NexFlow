PROJECT_NAME="NexFlow ERP Backend"
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_with_a_super_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (MySQL 8.0 default, or SQLite async fallback)
# MySQL format: mysql+asyncmy://username:password@localhost:3306/nexflow_erp
DATABASE_URL="mysql+asyncmy://root:password@localhost:3306/nexflow_erp"
# Alternative SQLite for zero-setup local dev/testing:
# DATABASE_URL="sqlite+aiosqlite:///./nexflow_erp.db"

# First-time Administrator Setup Environment Overrides (optional non-interactive seed)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_FULL_NAME=""
INITIAL_ADMIN_PASSWORD=""

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

